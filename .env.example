# PitCrew — required environment variables
# Copy to .env and fill in. Never commit .env.

# App
APP_BASE_URL=http://localhost:3000

# Auth0 (Phase 2)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=

# OpenRouter (Phase 4 — AI report generation; provisioned via Stripe Projects,
# auto-injected into .env by `stripe projects env --pull`)
OPENROUTER_API_API_KEY=
OPENROUTER_API_KEY=

# Stripe (Phase 6 — test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel (deploy only — already provisioned)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
